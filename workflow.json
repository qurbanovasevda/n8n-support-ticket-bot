    {
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const item of $input.all()) {\n  let category = 'unrecognized';\n  \n  try {\n    const raw = item.json.response;\n    const parsed = JSON.parse(raw);\n    const allowed = ['billing', 'technical', 'general'];\n    \n    if (parsed.category && allowed.includes(parsed.category)) {\n      category = parsed.category;\n    }\n  } catch (e) {\n    // JSON parse alınmadı — unrecognized olaraq qalır\n  }\n  \n  items.push({\n    json: {\n      ...item.json,\n      category: category\n    }\n  });\n}\n\nreturn items;"
      },
